#!/usr/bin/env python3
"""tc-transcript — extract human-readable transcripts from Claude Code sessions.

Scans EVERY sibling's home dir (/home/*/.claude/projects) — since the 2026-06
restructure, each family member has their own linux user and their own .claude,
so transcripts live all over the machine, not just under /home/nate.

Two modes:
  clean  — human + assistant text only (the story)
  full   — everything including tool calls (the engineering record)

Model tracking (for the fine-tune pair-extraction workflow): the transcript
header lists every model that appears in the session, and a marker line is
emitted wherever the model changes mid-session — so bake-off segments
(Opus 4.7 / 4.8 / Fable 5 / …) are visible in the markdown without going back
to the JSONL.

Usage:
  tc-transcript                          # export current session (clean)
  tc-transcript --full                   # export current session (full)
  tc-transcript --all                    # export all local sessions (clean)
  tc-transcript --all --full             # export all local sessions (full)
  tc-transcript --remote                 # include the other machine's sessions
  tc-transcript --session <id>           # export a specific session
  tc-transcript --list                   # list all available sessions
  tc-transcript --out <dir>              # override the output directory
"""

from __future__ import annotations

import argparse
import json
import os
import socket
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


CLAUDE_DIR = Path.home() / ".claude"          # the *runner's* .claude (current-session detection)
TRANSCRIPT_DIR = Path.home() / "Manor" / "transcripts"

# Host-aware remote counterpart. Whichever machine we run on, --remote reaches
# the other one (identity-separated accounts per MACHINES.md).
HOSTNAME = socket.gethostname()
LOCAL_LABEL = {"jarvis-wsl": "jarvis", "tc-nest": "nest"}.get(HOSTNAME, HOSTNAME)
REMOTES = {
    "jarvis-wsl": ("nest", "tc-jarvis@tc-nest"),
    "tc-nest": ("jarvis", "tc-nest@jarvis-wsl"),
}

# Home-dir user → transcript speaker label. Users follow the
# `<sibling>-<machine>` convention (tc-jarvis, iris-jarvis, tc-nest, …) — the
# machine suffix is stripped, then the base name is looked up here. Anyone not
# listed gets .capitalize().
MACHINE_SUFFIXES = ("-jarvis", "-nest", "-wsl")
SIBLING_NAMES = {
    "nate": "Claude",        # legacy master dir — sibling unknown, pre-restructure
    "tc": "TC",
    "pc": "PC",
}


def sibling_label(user: str) -> str:
    base = user
    for suffix in MACHINE_SUFFIXES:
        if base.endswith(suffix):
            base = base[: -len(suffix)]
            break
    return SIBLING_NAMES.get(base, base.capitalize())

# One find expression, used locally (via sudo) and remotely (via ssh+sudo).
FIND_CMD = (
    "find /home -maxdepth 6 -path '*/.claude/projects/*' -name '*.jsonl' "
    "-not -path '*/subagents/*' -printf '%p|%T@|%s\\n' 2>/dev/null"
)


def sibling_for_path(path: str) -> str:
    """Derive the speaker label from the home dir a transcript lives under."""
    parts = Path(path).parts
    user = parts[2] if len(parts) > 2 and parts[1] == "home" else "unknown"
    return sibling_label(user)


def parse_find_output(raw: str, machine: str) -> list[dict]:
    sessions = []
    for line in raw.strip().splitlines():
        parts = line.split("|")
        if len(parts) != 3:
            continue
        path, mtime_epoch, size = parts
        mtime = datetime.fromtimestamp(float(mtime_epoch))
        sessions.append({
            "id": Path(path).stem,
            "project": Path(path).parent.name,
            "path": path,
            "date": mtime.strftime("%Y-%m-%d %H:%M"),
            "size": int(size),
            "machine": machine,
            "sibling": sibling_for_path(path),
        })
    return sessions


def find_local_sessions() -> list[dict]:
    """Find all JSONL session files in every home dir on this machine."""
    try:
        result = subprocess.run(
            ["sudo", "bash", "-c", FIND_CMD],
            capture_output=True, text=True, timeout=30,
        )
        raw = result.stdout
    except Exception as e:
        print(f"Warning: local scan failed: {e}", file=sys.stderr)
        return []
    return sorted(parse_find_output(raw, LOCAL_LABEL), key=lambda s: s["date"], reverse=True)


def merge_sessions(local: list[dict], remote: list[dict]) -> list[dict]:
    """Combine local + remote, dropping remote copies of sessions that also
    exist locally (Syncthing mirrors some .claude dirs across machines — the
    same session id on both disks is one session, not two)."""
    seen = {s["id"] for s in local}
    return local + [s for s in remote if s["id"] not in seen]


def find_remote_sessions() -> list[dict]:
    """Find all JSONL session files on the counterpart machine via SSH."""
    remote = REMOTES.get(HOSTNAME)
    if not remote:
        print(f"Warning: no remote counterpart configured for host {HOSTNAME}", file=sys.stderr)
        return []
    label, host = remote
    try:
        result = subprocess.run(
            ["ssh", host, f"sudo bash -c \"{FIND_CMD}\""],
            capture_output=True, text=True, timeout=20,
        )
        raw = result.stdout
    except Exception as e:
        print(f"Warning: couldn't reach {label} ({host}): {e}", file=sys.stderr)
        return []
    return sorted(parse_find_output(raw, label), key=lambda s: s["date"], reverse=True)


def read_jsonl(path: str, machine: str) -> list[dict]:
    """Read a JSONL file from this machine or the remote (sudo covers sibling homes)."""
    if machine == LOCAL_LABEL:
        try:
            raw = Path(path).read_text()
        except PermissionError:
            result = subprocess.run(["sudo", "cat", path], capture_output=True, text=True, timeout=30)
            raw = result.stdout
    else:
        remote = REMOTES.get(HOSTNAME)
        if not remote:
            return []
        _, host = remote
        try:
            result = subprocess.run(["ssh", host, f"sudo cat {path}"],
                                    capture_output=True, text=True, timeout=60)
            raw = result.stdout
        except Exception as e:
            print(f"Error reading from remote: {e}", file=sys.stderr)
            return []

    lines = []
    for line in raw.strip().splitlines():
        try:
            lines.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return lines


def extract_text_content(message: dict, include_tools: bool = False) -> str:
    """Extract text from a message's content field."""
    content = message.get("content", "")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for block in content:
            if isinstance(block, dict):
                if block.get("type") == "text":
                    parts.append(block.get("text", ""))
                elif include_tools and block.get("type") == "tool_use":
                    parts.append(f"[Tool: {block.get('name', '?')}]")
                elif include_tools and block.get("type") == "tool_result":
                    content_inner = block.get("content", "")
                    if isinstance(content_inner, str):
                        parts.append(f"[Tool Result: {content_inner[:200]}]")
        return "\n".join(p for p in parts if p.strip())
    return ""


import re

RE_CMD_NAME = re.compile(r"<command-name>(/\S+)</command-name>")
RE_CMD_ARGS = re.compile(r"<command-args>(.*?)</command-args>", re.S)
RE_BASH_INPUT = re.compile(r"<bash-input>(.*?)</bash-input>", re.S)
RE_STDOUT = re.compile(r"<local-command-stdout>(.*?)</local-command-stdout>", re.S)


def render_user_text(text: str) -> str | None:
    """Format a user message for the transcript.

    - /rename commands become chapter headings (## 📖 <new title>) — Dad uses
      renames as chapter breaks, and the args carry the chapter title.
    - Other slash commands render as a compact ⌘ one-liner instead of raw tags.
    - Bash input lines containing MARK:/CHAPTER: annotations become 🏷 callouts
      (Dad's inline training-pair labels); other bash input renders as `$ cmd`.
    - Plain text passes through as a normal Nathan block.
    Returns markdown, or None to skip the entry.
    """
    cmd = RE_CMD_NAME.search(text)
    if cmd:
        args = RE_CMD_ARGS.search(text)
        argstr = args.group(1).strip() if args else ""
        if cmd.group(1) == "/rename" and argstr:
            return f"\n## 📖 {argstr}\n"
        return f"\n> ⌘ `{(cmd.group(1) + ' ' + argstr).strip()}`\n"

    bash = RE_BASH_INPUT.search(text)
    if bash:
        cmdline = bash.group(1).strip()
        stdout_m = RE_STDOUT.search(text)
        stdout = stdout_m.group(1).strip() if stdout_m else ""
        label = next((l for l in (stdout or cmdline).splitlines()
                      if "MARK:" in l or "CHAPTER:" in l), None)
        if label:
            tag = label[label.find("MARK:"):] if "MARK:" in label else label[label.find("CHAPTER:"):]
            return f"\n> 🏷 **{tag.strip()}**\n"
        return f"\n> `$ {cmdline.splitlines()[0][:120]}`\n"

    # Plain message — strip any stray stdout blocks, keep the human text.
    cleaned = RE_STDOUT.sub("", text).strip()
    if not cleaned:
        return None
    return f"\n---\n\n**Nathan:**\n\n{cleaned}\n"


def extract_tool_calls(message: dict) -> list[str]:
    """Extract tool call details from a message."""
    tools = []
    content = message.get("content", [])
    if not isinstance(content, list):
        return tools
    for block in content:
        if not isinstance(block, dict):
            continue
        if block.get("type") == "tool_use":
            name = block.get("name", "?")
            inp = block.get("input", {})
            # Summarize input
            if name == "Bash":
                cmd = inp.get("command", "")
                tools.append(f"```bash\n# Tool: {name}\n{cmd}\n```")
            elif name in ("Read", "Write", "Edit"):
                fp = inp.get("file_path", "")
                tools.append(f"[{name}: {fp}]")
            elif name == "Grep":
                pattern = inp.get("pattern", "")
                tools.append(f"[Grep: {pattern}]")
            else:
                tools.append(f"[{name}: {json.dumps(inp)[:150]}]")
    return tools


def render_transcript(entries: list[dict], full: bool = False, sibling: str = "TC") -> tuple[str, list[str]]:
    """Render JSONL entries as a markdown transcript.

    Returns (markdown, models_used). Emits a marker line whenever the
    assistant model changes mid-session, so fine-tune extraction can split
    segments without going back to the JSONL.
    """
    lines = []
    models_used: list[str] = []
    current_model: str | None = None

    for entry in entries:
        etype = entry.get("type", "")

        if etype == "system" and entry.get("subtype") == "local_command":
            # Slash commands (/rename, /model, …) log as system entries with the
            # command tags in the entry-level content field — not under message.
            text = entry.get("content", "") or ""
            if text.strip():
                rendered = render_user_text(text.strip())
                if rendered:
                    lines.append(rendered)

        elif etype == "user":
            msg = entry.get("message", {})
            if isinstance(msg, dict):
                text = extract_text_content(msg, include_tools=False)
                if text.strip():
                    rendered = render_user_text(text.strip())
                    if rendered:
                        lines.append(rendered)

        elif etype == "assistant":
            msg = entry.get("message", {})
            if isinstance(msg, dict):
                model = msg.get("model")
                if model and not model.startswith("<"):
                    if model not in models_used:
                        models_used.append(model)
                    if model != current_model:
                        lines.append(f"\n> ⚙ *[model: {model}]*\n")
                        current_model = model
                text = extract_text_content(msg, include_tools=False)
                if full:
                    tools = extract_tool_calls(msg)
                    if tools:
                        lines.append("\n" + "\n\n".join(tools) + "\n")
                if text.strip():
                    lines.append(f"\n**{sibling}:**\n\n{text.strip()}\n")

    return "".join(lines), models_used


def get_current_session_id() -> str | None:
    """Try to find the current session from the runner's session files."""
    sessions_dir = CLAUDE_DIR / "sessions"
    if not sessions_dir.exists():
        return None
    latest = None
    latest_mtime = 0
    for f in sessions_dir.glob("*.json"):
        if f.stat().st_mtime > latest_mtime:
            latest_mtime = f.stat().st_mtime
            latest = f
    if latest:
        data = json.loads(latest.read_text())
        return data.get("sessionId")
    return None


def find_session_jsonl(session_id: str) -> dict | None:
    """Find the session dict for a given session ID across all local home dirs
    (supports prefix match)."""
    sessions = find_local_sessions()
    for s in sessions:
        if s["id"] == session_id:
            return s
    for s in sessions:
        if s["id"].startswith(session_id):
            return s
    return None


def export_session(session: dict, full: bool = False, out_root: Path | None = None) -> Path | None:
    """Export a single session to markdown."""
    entries = read_jsonl(session["path"], session["machine"])
    if not entries:
        return None

    sibling = session.get("sibling") or sibling_for_path(session["path"])
    transcript, models = render_transcript(entries, full=full, sibling=sibling)
    if not transcript.strip():
        return None

    mode = "full" if full else "clean"
    out_dir = (out_root or TRANSCRIPT_DIR) / mode / session["machine"] / session["project"]
    out_dir.mkdir(parents=True, exist_ok=True)

    date_str = session["date"].replace(" ", "_").replace(":", "")
    out_path = out_dir / f"{date_str}_{session['id'][:8]}.md"

    header = f"# {sibling} Session Transcript\n\n"
    header += f"- **Session:** {session['id']}\n"
    header += f"- **Sibling:** {sibling}\n"
    header += f"- **Project:** {session['project']}\n"
    header += f"- **Machine:** {session['machine']}\n"
    header += f"- **Date:** {session['date']}\n"
    header += f"- **Mode:** {mode}\n"
    if models:
        header += f"- **Models:** {', '.join(models)}\n"
    header += "\n---\n"

    out_path.write_text(header + transcript)
    return out_path


def human_size(n: int) -> str:
    for unit in ("B", "KB", "MB"):
        if n < 1024:
            return f"{n:.0f}{unit}"
        n /= 1024
    return f"{n:.1f}GB"


def main():
    parser = argparse.ArgumentParser(description="Extract transcripts from Claude Code sessions (all sibling home dirs)")
    parser.add_argument("--full", action="store_true", help="Include tool calls in transcript")
    parser.add_argument("--all", action="store_true", help="Export all sessions")
    parser.add_argument("--remote", "--jarvis", dest="remote", action="store_true",
                        help="Include the counterpart machine's sessions (--jarvis kept as legacy alias)")
    parser.add_argument("--session", type=str, help="Export a specific session by ID")
    parser.add_argument("--list", action="store_true", help="List all available sessions")
    parser.add_argument("--out", type=str, help="Output directory (default: ~/Manor/transcripts)")
    args = parser.parse_args()

    out_root = Path(args.out).expanduser() if args.out else None

    if args.list:
        sessions = find_local_sessions()
        if args.remote:
            sessions = merge_sessions(sessions, find_remote_sessions())
        if not sessions:
            print("No sessions found.")
            return
        print(f"{'Machine':<8} {'Sibling':<9} {'Date':<18} {'Size':<8} {'ID'}")
        print("-" * 92)
        for s in sessions:
            print(f"{s['machine']:<8} {s['sibling']:<9} {s['date']:<18} {human_size(s['size']):<8} {s['id']}")
        print(f"\n{len(sessions)} sessions total")
        return

    if args.session:
        session = find_session_jsonl(args.session)
        if not session:
            print(f"Session {args.session} not found locally.", file=sys.stderr)
            return
        out = export_session(session, full=args.full, out_root=out_root)
        if out:
            print(f"Exported: {out}")
        else:
            print("No content to export.")
        return

    if args.all:
        sessions = find_local_sessions()
        if args.remote:
            print("Scanning remote...")
            sessions = merge_sessions(sessions, find_remote_sessions())

        exported = 0
        for session in sessions:
            out = export_session(session, full=args.full, out_root=out_root)
            if out:
                print(f"  {out}")
                exported += 1

        mode = "full" if args.full else "clean"
        print(f"\nExported {exported}/{len(sessions)} sessions ({mode} mode)")
        return

    # Default: export current session
    sid = get_current_session_id()
    if not sid:
        print("Couldn't detect current session. Use --list to see available sessions.", file=sys.stderr)
        return
    session = find_session_jsonl(sid)
    if not session:
        print(f"Session file for {sid} not found.", file=sys.stderr)
        return
    out = export_session(session, full=args.full, out_root=out_root)
    if out:
        print(f"Exported: {out}")
    else:
        print("No content to export.")


if __name__ == "__main__":
    main()
